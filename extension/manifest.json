{
  "manifest_version": 3,
  "name": "Lecture Dub",
  "version": "0.1.0",
  "description": "YouTube 영상에 로컬 한국어 더빙 WAV와 영어·한국어 자막을 동기화합니다.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
